# Main deployment variable names (higher priority than G5 compatibility aliases below):
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus?currentSchema=m2
# DATABASE_USERNAME=app_m2
# DATABASE_PASSWORD=replace_with_private_runtime_password
# MIGRATION_USERNAME=migrate_m2
# MIGRATION_PASSWORD=replace_with_private_migration_password
# MIGRATION_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/campus?currentSchema=m2
# SERVER_ADDRESS=127.0.0.1
# PORT=8082

# Reference only: Spring Boot does not automatically load this file.
# Set these as environment variables before starting the application.
DB_URL=jdbc:postgresql://127.0.0.1:5432/pj_local
DB_USERNAME=replace_with_runtime_user
DB_PASSWORD=replace_with_private_password
DB_MIGRATION_USERNAME=replace_with_migration_user
DB_MIGRATION_PASSWORD=replace_with_private_password
# Optional: separate migration connection URL; defaults to DB_URL.
# DB_MIGRATION_URL=jdbc:postgresql://127.0.0.1:5432/pj_local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8082
MANAGEMENT_PORT=18082

# First deployment only. No default plaintext password is provided.
G5_BOOTSTRAP_ENABLED=false
G5_BOOTSTRAP_ACCOUNT=admin
# G5_BOOTSTRAP_PASSWORD=replace_with_private_random_password

# Required for management writes. Persist privately across restarts; 32-256 characters.
# G5_IDEMPOTENCY_HMAC_KEY=replace_with_private_stable_random_secret

# Each consumer needs a DIFFERENT 32-256-character secret; absent means denied.
# G5_SERVICE_G1_TOKEN=replace_with_private_service_secret
# G5_SERVICE_G2_TOKEN=replace_with_private_service_secret_for_config_and_eligibility
# G5_SERVICE_G3_TOKEN=replace_with_private_service_secret
# G5_SERVICE_G4_TOKEN=replace_with_private_service_secret
# G5_SERVICE_G6_TOKEN=replace_with_private_service_secret

# G5 consumer of G4-I02. Required for room authorization/qualification/notifications and saving ROOM grants; absent fails closed.
# Origin only (no path/query/userinfo). Connection 2s; total room validation budget 5s.
# G4_BASE_URL=http://127.0.0.1:8081
# G4_SERVICE_G5_TOKEN=replace_with_private_G5_to_G4_secret
# G5 to G6 event delivery. Origin only, no path/query/userinfo; secret kept private.
# G6_BASE_URL=http://127.0.0.1:8083
# G6_SERVICE_G5_TOKEN=replace_with_private_G5_to_G6_secret
# Default true: missing/invalid G6 configuration makes pending operations visibly BLOCKED.
# Set false only for an explicitly paused dispatcher; events remain durable and queryable.
G5_OUTBOX_ENABLED=true
