      "description": "只约束新个人预约，已有合法预约保留原规则。",
      "x-unit": "小时",
      "x-owner-group": "G1"
    },
    "reservationAdvanceDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "default": 7,
      "title": "个人预约提前天数",
      "description": "新个人预约可提前申请的天数。",
      "x-unit": "天",
      "x-owner-group": "G1"
    }
  }
}
