{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-review-status": "BASELINE_PENDING_OWNER_REVIEW",
  "x-source": "技术文档v2 §4.3、§5.5",
  "$id": "urn:pj:g5:proposed:G1:ConfigValues:v1",
  "title": "G1 参数基线（G5 按文档整理，待 owner 确认）",
  "x-owner-group": "G1",
