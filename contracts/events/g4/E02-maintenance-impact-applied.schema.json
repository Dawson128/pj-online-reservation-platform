{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj-online-reservation-platform/contracts/events/g4/E02-maintenance-impact-applied.schema.json",
  "title": "G4-E02 MaintenanceImpactApplied",
  "description": "维护影响实际生效后由 G4 发出，用于集中审计。无额外邮件：受影响个人预约与整室申请的取消通知由 G1、G2 各自的本人取消事件覆盖，避免重复通知。\n\n生产者：G4（reservation-service）。依据：技术文档 v2.0 §8.1 事件表。\n\n信封字段由 G6 维护的 EventEnvelope 规定，本文件内联等价结构并标注 x-pending-common: G6。\n\n必填与 null 约束：roomId 必须非 null；actorId 可为 null（系统任务）；operationId 可为 null。两个计数允许为 0，但字段必须存在。",
  "x-contract": {
    "owner": "G4",
    "eventType": "MaintenanceImpactApplied",
    "producer": "G4",
    "schemaVersion": 1,
    "status": "draft",
    "x-pending-common": "G6",
    "consumers": ["G6"],
    "baseline": "技术文档 v2.0 §8.1"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "producer",
    "aggregate",
    "aggregateVersion",
    "roomId",
    "occurredAt",
    "actorId",
    "actorKind",
    "traceId",
    "operationId",
    "audit",
    "payload"
  ],
  "properties": {
    "eventId": { "$ref": "#/$defs/Id" },
    "eventType": { "const": "MaintenanceImpactApplied" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "G4" },
    "aggregate": { "$ref": "#/$defs/Ref" },
    "aggregateVersion": { "$ref": "#/$defs/Version" },
    "roomId": { "$ref": "#/$defs/Id" },
    "occurredAt": { "$ref": "#/$defs/Time" },
    "actorId": {
      "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
    },
    "actorKind": { "enum": ["USER", "SYSTEM"] },
    "traceId": { "$ref": "#/$defs/Id" },
    "operationId": {
      "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
    },
    "audit": { "$ref": "#/$defs/Audit" },
    "payload": { "$ref": "#/$defs/Payload" }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Version": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
    "Time": { "type": "string", "format": "date-time" },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["PERSONAL", "WHOLE", "REPAIR", "ADMIN", "ACCOUNT", "CONFIG", "SYSTEM"]
        },
        "id": { "$ref": "#/$defs/Id" }
      }
    },
    "AuditField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "Audit": {
      "type": "object",
      "description": "审计事实。audit.id 必须等于 eventId。",
      "additionalProperties": false,
      "required": [
        "id",
        "producer",
        "source",
        "roomId",
        "scopeKind",
        "actorId",
        "actorKind",
        "action",
        "before",
        "after",
        "reason",
        "result",
        "errorCode",
        "effectiveAt",
        "processedAt",
        "traceId",
        "operationId"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "producer": { "enum": ["G1", "G2", "G3", "G4", "G5", "G6"] },
        "source": { "$ref": "#/$defs/Ref" },
        "roomId": {
          "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
        },
        "scopeKind": { "enum": ["ROOM", "SYSTEM"] },
        "actorId": {
          "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
        },
        "actorKind": { "enum": ["USER", "SYSTEM"] },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "before": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/AuditField" }
        },
        "after": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/AuditField" }
        },
        "reason": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "result": { "enum": ["SUCCESS", "FAILURE"] },
        "errorCode": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "effectiveAt": { "$ref": "#/$defs/Time" },
        "processedAt": { "$ref": "#/$defs/Time" },
        "traceId": { "$ref": "#/$defs/Id" },
        "operationId": {
          "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
        }
      }
    },
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "affectedPersonalCount",
        "affectedWholeCount",
        "effectiveAt",
        "reason"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/Ref",
          "description": "本次维护来源（ADMIN 或 REPAIR）。"
        },
        "affectedPersonalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "被系统取消的个人预约条数。"
        },
        "affectedWholeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "被失效的已批准整室申请条数。"
        },
        "effectiveAt": {
          "$ref": "#/$defs/Time",
          "description": "维护影响的实际生效时刻（系统确认时刻）。"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  },
  "examples": [
    {
      "eventId": "00000000-0000-4000-8000-000000000043",
      "eventType": "MaintenanceImpactApplied",
      "schemaVersion": 1,
      "producer": "G4",
      "aggregate": { "type": "ADMIN", "id": "00000000-0000-4000-8000-000000000042" },
      "aggregateVersion": "1",
      "roomId": "00000000-0000-4000-8000-000000000010",
      "occurredAt": "2026-10-24T08:00:00.000+08:00",
      "actorId": "00000000-0000-4000-8000-000000000020",
      "actorKind": "USER",
      "traceId": "00000000-0000-4000-8000-000000000099",
      "operationId": "00000000-0000-4000-8000-000000000030",
      "audit": {
        "id": "00000000-0000-4000-8000-000000000043",
        "producer": "G4",
        "source": { "type": "ADMIN", "id": "00000000-0000-4000-8000-000000000042" },
        "roomId": "00000000-0000-4000-8000-000000000010",
        "scopeKind": "ROOM",
        "actorId": "00000000-0000-4000-8000-000000000020",
        "actorKind": "USER",
        "action": "G4-P12",
        "before": [],
        "after": [{ "name": "affectedPersonalCount", "value": "1" }],
        "reason": "空调检修",
        "result": "SUCCESS",
        "errorCode": null,
        "effectiveAt": "2026-10-24T08:00:00.000+08:00",
        "processedAt": "2026-10-24T08:00:00.000+08:00",
        "traceId": "00000000-0000-4000-8000-000000000099",
        "operationId": "00000000-0000-4000-8000-000000000030"
      },
      "payload": {
        "source": { "type": "ADMIN", "id": "00000000-0000-4000-8000-000000000042" },
        "affectedPersonalCount": 1,
        "affectedWholeCount": 0,
        "effectiveAt": "2026-10-24T08:00:00.000+08:00",
        "reason": "空调检修"
      }
    }
  ]
}
